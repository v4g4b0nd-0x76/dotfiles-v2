font_family JetBrainsMono Nerd Font
bold_font auto
italic_font auto
bold_italic_font auto
font_size 13

confirm_os_window_close 0
enable_audio_bell no
hide_window_decorations titlebar-only
cursor_shape beam
cursor_blink_interval 0
scrollback_lines 100000
background_opacity 0.93
watch_config_file yes

foreground            #ebdbb2
background            #1d2021
selection_foreground  #1d2021
selection_background  #fabd2f

color0  #282828
color1  #cc241d
color2  #98971a
color3  #d79921
color4  #458588
color5  #b16286
color6  #689d6a
color7  #a89984
color8  #928374
color9  #fb4934
color10 #b8bb26
color11 #fabd2f
color12 #83a598
color13 #d3869b
color14 #8ec07c
color15 #fbf1c7

cursor               #fabd2f
cursor_text_color    background

active_tab_background   #3c3836
active_tab_foreground   #ebdbb2
inactive_tab_background #282828
inactive_tab_foreground #928374

map ctrl+f launch --stdin-source=@screen_scrollback --type=overlay kitten search --regex
shell_integration enabled


