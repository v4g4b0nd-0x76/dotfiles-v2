;;; kuro-nezumi-theme.el --- soot black, ash gray, worn paper, signal red -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'doom-themes)

(def-doom-theme kuro-nezumi
  "Kuro Nezumi, ported from the Neovim theme."
  :family 'kuro-nezumi
  :background-mode 'dark

  ((ink       '("#050505" "#050505" "black"))
   (ink-alt   '("#0c0c0c" "#0c0c0c" "black"))
   (surface   '("#141414" "#141414" "black"))
   (raised    '("#1c1c1c" "#1c1c1c" "brightblack"))
   (border    '("#303030" "#303030" "brightblack"))
   (paper     '("#cdc4ba" "#cdc4ba" "brightwhite"))
   (soft      '("#9b948b" "#9b948b" "white"))
   (muted     '("#69645d" "#69645d" "brightblack"))
   (signal    '("#b73535" "#b73535" "red"))
   (alert     '("#d94a4a" "#d94a4a" "brightred"))
   (moss      '("#8a8f73" "#8a8f73" "green"))
   (brass     '("#b8a781" "#b8a781" "yellow"))
   (steel     '("#8c9097" "#8c9097" "blue"))
   (oxide     '("#7f9693" "#7f9693" "cyan"))
   (selection '("#2a1818" "#2a1818" "red"))

   (bg ink)
   (bg-alt surface)
   (base0 ink)
   (base1 ink-alt)
   (base2 surface)
   (base3 raised)
   (base4 border)
   (base5 muted)
   (base6 soft)
   (base7 paper)
   (base8 paper)
   (fg paper)
   (fg-alt soft)

   (grey muted)
   (red alert)
   (orange brass)
   (green moss)
   (teal oxide)
   (yellow brass)
   (blue steel)
   (dark-blue steel)
   (magenta soft)
   (violet soft)
   (cyan oxide)
   (dark-cyan oxide)

   (highlight alert)
   (vertical-bar border)
   (selection selection)
   (builtin soft)
   (comments muted)
   (doc-comments soft)
   (constants brass)
   (functions oxide)
   (keywords alert)
   (methods oxide)
   (operators soft)
   (type steel)
   (strings brass)
   (variables paper)
   (numbers brass)
   (region selection)
   (error alert)
   (warning brass)
   (success moss)
   (vc-modified brass)
   (vc-added moss)
   (vc-deleted alert)
   (modeline-bg raised)
   (modeline-fg paper)
   (modeline-inactive-bg surface)
   (modeline-inactive-fg muted))

  ((cursor :background paper)
   (hl-line :background ink-alt)
   (region :background selection)
   (line-number :foreground muted :background bg)
   (line-number-current-line :foreground paper :background ink-alt :weight 'bold)
   (fringe :background bg)
   (vertical-border :foreground border)
   (window-divider :foreground border)
   (minibuffer-prompt :foreground oxide :weight 'bold)
   (font-lock-comment-face :foreground muted :slant 'normal)
   (font-lock-keyword-face :foreground alert :weight 'bold)
   (font-lock-builtin-face :foreground soft)
   (font-lock-function-name-face :foreground oxide)
   (font-lock-string-face :foreground brass)
   (font-lock-constant-face :foreground brass)
   (font-lock-type-face :foreground steel :weight 'bold)
   (font-lock-variable-name-face :foreground paper)
   (font-lock-warning-face :foreground alert :weight 'bold)
   (show-paren-match :foreground alert :weight 'bold)
   (isearch :foreground paper :background signal)
   (lazy-highlight :foreground ink :background brass)
   (mode-line :foreground modeline-fg :background modeline-bg)
   (mode-line-inactive :foreground modeline-inactive-fg :background modeline-inactive-bg)
   (doom-modeline-bar :background signal)
   (doom-modeline-buffer-file :foreground paper :weight 'bold)
   (doom-modeline-buffer-modified :foreground brass)
   (doom-modeline-info :foreground oxide)
   (doom-modeline-warning :foreground brass)
   (doom-modeline-error :foreground alert)
   (completions-common-part :foreground oxide :weight 'bold)
   (completions-first-difference :foreground alert :weight 'bold)
   (corfu-default :foreground soft :background surface)
   (corfu-current :foreground paper :background selection)
   (vertico-current :foreground paper :background selection :weight 'bold)
   (marginalia-documentation :foreground muted)
   (dired-directory :foreground oxide :weight 'bold)
   (dired-marked :foreground brass)
   (dired-symlink :foreground oxide)
   (treemacs-root-face :foreground paper :weight 'bold)
   (treemacs-directory-face :foreground oxide)
   (treemacs-file-face :foreground paper)
   (treemacs-git-modified-face :foreground brass)
   (treemacs-git-added-face :foreground moss)
   (treemacs-git-untracked-face :foreground soft)
   (treemacs-git-ignored-face :foreground muted)
   (treemacs-git-conflict-face :foreground alert)
   (magit-section-heading :foreground oxide :weight 'bold)
   (magit-branch-local :foreground steel)
   (magit-branch-current :foreground brass :weight 'bold)
   (magit-diff-context :foreground soft :background bg)
   (magit-diff-context-highlight :foreground paper :background ink-alt)
   (magit-diff-added :foreground moss :background ink-alt)
   (magit-diff-removed :foreground alert :background ink-alt)
   (magit-diff-hunk-heading :foreground soft :background surface)
   (magit-diff-hunk-heading-highlight :foreground paper :background raised)
   (org-level-1 :foreground alert :weight 'bold :height 1.2)
   (org-level-2 :foreground oxide :weight 'bold :height 1.1)
   (org-level-3 :foreground brass :weight 'bold)
   (org-level-4 :foreground steel :weight 'bold)
   (org-code :foreground brass :background ink-alt)
   (org-block :background ink-alt)
   (org-block-begin-line :foreground muted :background surface)
   (org-block-end-line :foreground muted :background surface)
   (markdown-header-face-1 :foreground alert :weight 'bold)
   (markdown-header-face-2 :foreground oxide :weight 'bold)
   (markdown-code-face :foreground brass :background ink-alt)
   (flycheck-error :underline `(:style wave :color ,alert))
   (flycheck-warning :underline `(:style wave :color ,brass))
   (flycheck-info :underline `(:style wave :color ,steel))))

;;; kuro-nezumi-theme.el ends here
