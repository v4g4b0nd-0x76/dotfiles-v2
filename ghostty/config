# JetBrains Mono for code; Noto Sans Mono CJK JP covers Japanese glyphs
# (e.g. the 浪人 dashboard header) that the Nerd Font does not include.
font-family = JetBrainsMono Nerd Font
font-family = Noto Sans Mono CJK JP
font-size = 16

confirm-close-surface = false
window-decoration = false

cursor-style = bar
cursor-style-blink = false

scrollback-limit = 10000000
background-opacity = 0.97

theme = /Users/vangabond/dotfiles/ghostty/srcery.conf
# Native Ghostty Dock/app-switcher icon. Do not use Finder custom-icon metadata.
macos-icon = custom
macos-custom-icon = /Users/vangabond/dotfiles/icons/kuro-nezumi/ghostty-ronin.png
window-vsync = false
background-blur = true
font-thicken = false
